@* Port of ItemsEditor in components/TodoCard.tsx: all of a list's items as Markdown in one text box, one per
   line, for changing many of them at once. Grows with its content (editor.js's bindAutoGrow) and starts focused
   at the end. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="mt-2">
    <textarea @ref="_textarea" aria-label="@($"Items in {Title} as Markdown")" aria-describedby="@_hintId"
              value="@_text" @oninput="@(e => _text = e.Value?.ToString() ?? "")" @onkeydown="OnKeyDownAsync" rows="3"
              placeholder="- [ ] An item"
              class="block w-full resize-none rounded-lg border border-stone-300 bg-white px-2 py-1.5 font-mono text-sm leading-relaxed outline-none focus:border-maple-500 dark:border-stone-700 dark:bg-stone-950"></textarea>
    <p id="@_hintId" class="mt-1 text-xs text-stone-500 dark:text-stone-400">
        One item per line: <code>- [ ]</code> to do, <code>- [x]</code> done. Other lines become items to do.
    </p>
    <div class="mt-2 flex items-center justify-end gap-2">
        <span class="mr-auto hidden text-xs text-stone-400 sm:inline">Ctrl/⌘ + Enter to save</span>
        <Button Variant="ButtonVariant.Ghost" OnClick="Cancel">Cancel</Button>
        <Button OnClick="Save">Save</Button>
    </div>
</div>

@code {
    private const int MaxTextareaPixels = 480;
    private static int s_counter;
    private readonly string _hintId = $"items-editor-hint-{Interlocked.Increment(ref s_counter)}";
    private ElementReference _textarea;
    private IJSObjectReference? _module;
    private string _text = "";

    /// <summary>The list's name, for the text box's accessible name.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The items as Markdown, as first shown.</summary>
    [Parameter, EditorRequired] public string Initial { get; set; } = "";

    /// <summary>Called with the edited Markdown when Save is chosen, or Ctrl/⌘ + Enter is pressed.</summary>
    [Parameter] public EventCallback<string> OnSave { get; set; }

    /// <summary>Called when Cancel is chosen, or Escape is pressed.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => _text = Initial;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/editor.js");
        await _module.InvokeVoidAsync("bindAutoGrow", _textarea, MaxTextareaPixels);
        await _module.InvokeVoidAsync("focusAtEnd", _textarea);
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey))
        {
            await Save();
        }
        else if (e.Key == "Escape")
        {
            await Cancel();
        }
    }

    private Task Save() => OnSave.InvokeAsync(_text);

    private Task Cancel() => OnCancel.InvokeAsync();

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
