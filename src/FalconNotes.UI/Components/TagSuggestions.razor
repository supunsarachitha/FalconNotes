@* Port of useTagSuggestions in components/TagSuggestions.tsx: suggests the device's existing tags while a #tag is
   typed in a text box, in a list next to the caret (editor.js positions it); arrows move through it, Enter or Tab
   puts the chosen tag in, Esc closes it for that tag until the caret leaves it. The text box keeps focus throughout.
   Composer calls UpdateAsync/Close/OnKeyDownAsync and renders this inside a `relative` box around the text box. *@
@using FalconNotes.Core.Events
@using FalconNotes.Core.Notes
@using FalconNotes.Core.Text
@using FalconNotes.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NoteService Notes
@inject AppState State
@inject ChangeFeed Feed

@if (_open is { } open)
{
    <ul @ref="_popup" id="@_listId" role="listbox" aria-label="Tag suggestions" style="position: absolute; visibility: hidden"
        class="z-20 max-w-full overflow-hidden rounded-xl border border-stone-200 bg-white p-1 text-sm shadow-lg dark:border-stone-700 dark:bg-stone-900">
        @for (var i = 0; i < open.Items.Count; i++)
        {
            var index = i;
            var tag = open.Items[index];
            <li id="@OptionId(index)" role="option" aria-selected="@(index == open.Active ? "true" : "false")"
                @onmousedown:preventDefault @onclick="() => ChooseAsync(tag)"
                class="@Classes.Join("flex cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2", index == open.Active ? "bg-maple-50 text-maple-700 dark:bg-maple-600/15 dark:text-maple-400" : "hover:bg-stone-100 dark:hover:bg-stone-800")">
                <Icon Name="IconName.Hash" Class="size-3.5 shrink-0 opacity-70" />
                <span class="min-w-0 flex-1 truncate">@tag.Name</span>
                <span class="shrink-0 text-xs tabular-nums text-stone-500 dark:text-stone-400">@tag.NoteCount</span>
            </li>
        }
    </ul>
}
@if (Enabled)
{
    <span class="sr-only" aria-live="polite">@LiveText</span>
}

@code {
    private const int PopupWidth = 256;

    private readonly string _listId = $"tags-{Guid.NewGuid():N}";
    private ElementReference _popup;
    private IJSObjectReference? _module;
    private IReadOnlyList<TagCount> _tags = [];
    private Open? _open;
    private int? _dismissedAt;
    private int? _pendingCaret;

    /// <summary>The text box tags are suggested for.</summary>
    [Parameter, EditorRequired] public ElementReference Target { get; set; }

    /// <summary>Whether suggestions are turned on (the preference).</summary>
    [Parameter] public bool Enabled { get; set; }

    /// <summary>Called with the text box's new value when a suggestion is chosen.</summary>
    [Parameter, EditorRequired] public EventCallback<string> OnTextChanged { get; set; }

    /// <summary>Whether the popup is open.</summary>
    public bool IsOpen => _open is not null;

    /// <summary>For the text box's <c>aria-controls</c> while open.</summary>
    public string? AriaControls => _open is not null ? _listId : null;

    /// <summary>For the text box's <c>aria-activedescendant</c> while open.</summary>
    public string? AriaActiveDescendant => _open is { } open ? OptionId(open.Active) : null;

    private string LiveText => _open is { } o
        ? $"{(o.Items.Count == 1 ? "1 tag suggestion" : $"{o.Items.Count} tag suggestions")}. Arrows to choose, Enter to insert."
        : "";

    private string OptionId(int index) => $"{_listId}-option-{index}";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Feed.NotesChanged += Reload;
        if (Enabled)
        {
            _tags = await Notes.TagCountsAsync(State.EnabledKinds);
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingCaret is { } caret)
        {
            _pendingCaret = null;
            var module = await ModuleAsync();
            await module.InvokeVoidAsync("setSelection", Target, caret, caret);
        }
    }

    /// <summary>Call after the text box's value or selection changes (typing or moving the caret).</summary>
    public async Task UpdateAsync()
    {
        if (!Enabled)
        {
            return;
        }

        var module = await ModuleAsync();
        var selection = await module.InvokeAsync<EditorSelection>("getSelection", Target);
        if (selection.Start != selection.End)
        {
            _open = null;
            StateHasChanged();
            return;
        }

        var query = TagSuggest.QueryAt(selection.Value, selection.Start);
        if (query is null)
        {
            _dismissedAt = null;
            _open = null;
            StateHasChanged();
            return;
        }

        if (query.Start == _dismissedAt)
        {
            _open = null;
            StateHasChanged();
            return;
        }

        var items = TagSuggest.Suggest(_tags, query.Text);
        if (items.Count == 0)
        {
            _open = null;
            StateHasChanged();
            return;
        }

        var active = _open is { } current ? Math.Max(0, items.ToList().FindIndex(i => i.Name == current.Items.ElementAtOrDefault(current.Active)?.Name)) : 0;
        _open = new Open(query, selection.Start, items, active);
        StateHasChanged();
        await module.InvokeVoidAsync("positionPopup", Target, _popup, query.Start, PopupWidth);
    }

    /// <summary>Closes the popup (the text box lost focus).</summary>
    public void Close()
    {
        _open = null;
        StateHasChanged();
    }

    /// <summary>Handles a key the text box got. Returns true when it was for the popup, so the caller stops there.</summary>
    /// <param name="key">The key, as <see cref="Microsoft.AspNetCore.Components.Web.KeyboardEventArgs.Key"/> gives it.</param>
    /// <param name="metaKey">Whether ⌘ was held.</param>
    /// <param name="ctrlKey">Whether Ctrl was held.</param>
    /// <param name="shiftKey">Whether Shift was held.</param>
    public async Task<bool> OnKeyDownAsync(string key, bool metaKey, bool ctrlKey, bool shiftKey)
    {
        if (_open is not { } open)
        {
            return false;
        }

        switch (key)
        {
            case "ArrowDown":
                _open = open with { Active = (open.Active + 1) % open.Items.Count };
                break;
            case "ArrowUp":
                _open = open with { Active = (open.Active - 1 + open.Items.Count) % open.Items.Count };
                break;
            case "Enter" when !metaKey && !ctrlKey && !shiftKey:
            case "Tab":
                await ChooseAsync(open.Items[open.Active]);
                break;
            case "Escape":
                _dismissedAt = open.Query.Start;
                _open = null;
                break;
            default:
                return false;
        }

        StateHasChanged();
        return true;
    }

    private async Task ChooseAsync(TagCount tag)
    {
        if (_open is not { } open)
        {
            return;
        }

        var module = await ModuleAsync();
        var selection = await module.InvokeAsync<EditorSelection>("getSelection", Target);
        var (text, caret) = TagSuggest.Insert(selection.Value, open.Query, open.Caret, tag.Name);
        _open = null;
        _pendingCaret = caret;
        await OnTextChanged.InvokeAsync(text);
    }

    private void Reload() => _ = InvokeAsync(async () =>
    {
        if (Enabled)
        {
            _tags = await Notes.TagCountsAsync(State.EnabledKinds);
        }
    });

    private async Task<IJSObjectReference> ModuleAsync() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/editor.js");

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Feed.NotesChanged -= Reload;
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed record Open(TagQuery Query, int Caret, IReadOnlyList<TagCount> Items, int Active);
}
