@* Port of ImageViewer in components/ImageViewer.tsx, adapted per docs/07, Attachments: the download link becomes
   Save a copy (IFileSaver); on Android, Share hands a decrypted copy to the system share sheet (docs/12, Share). A
   full-screen viewer for a note's images, fitted to the screen, with previous/next by button, arrow key or swipe,
   and Esc or the close button to leave. *@
@using FalconNotes.Core.Attachments
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Platform
@using FalconNotes.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AttachmentService Attachments
@inject IFileSaver Saver
@inject IShare Share
@inject IAppDirectories Directories
@inject Toasts Toasts

<dialog @ref="_dialog" aria-label="@(Image?.FileName ?? "Image")"
        class="m-0 h-dvh max-h-none w-dvw max-w-none flex-col bg-black/95 p-0 text-white backdrop:bg-transparent"
        @onkeydown="OnKeyDownAsync">
    @if (Open)
    {
        <div class="flex items-center gap-2 p-3 pt-[max(0.75rem,var(--safe-top,env(safe-area-inset-top)))]">
            <h2 class="min-w-0 flex-1 truncate px-2 text-sm">
                @Image!.FileName
                @if (Many)
                {
                    <span class="ml-2 text-white/60">@($"{Index + 1} / {Images.Count}")</span>
                }
            </h2>
            <button type="button" aria-label="@($"Save a copy of {Image.FileName}")" @onclick="SaveCopyAsync" class="@Control">
                <Icon Name="IconName.Download" Class="size-5" />
            </button>
            <button type="button" aria-label="@($"Share {Image.FileName}")" @onclick="ShareAsync" class="@Control">
                <Icon Name="IconName.Share" Class="size-5" />
            </button>
            <button type="button" aria-label="Close" @onclick="CloseAsync" class="@Control">
                <Icon Name="IconName.X" Class="size-5" />
            </button>
        </div>
        <div class="relative flex min-h-0 flex-1 touch-pan-y items-center justify-center px-2 pb-[max(0.75rem,var(--safe-bottom,env(safe-area-inset-bottom)))]"
             @onpointerdown="(e) => _swipeStartX = e.ClientX" @onpointerup="OnPointerUpAsync">
            <img src="@MediaUrl.For(Image)" alt="@Image.FileName" draggable="false" class="max-h-full max-w-full select-none object-contain" />
            @if (Many)
            {
                <button type="button" aria-label="Previous image" @onclick="() => GoAsync(-1)"
                        class="@Classes.Join(Control, "absolute left-3 top-1/2 -translate-y-1/2")">
                    <Icon Name="IconName.ChevronLeft" Class="size-6" />
                </button>
                <button type="button" aria-label="Next image" @onclick="() => GoAsync(1)"
                        class="@Classes.Join(Control, "absolute right-3 top-1/2 -translate-y-1/2")">
                    <Icon Name="IconName.ChevronRight" Class="size-6" />
                </button>
            }
        </div>
    }
</dialog>

@code {
    private const string Control =
        "flex size-11 items-center justify-center rounded-full bg-black/50 text-white transition-colors hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-white";

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ImageViewer>? _self;
    private bool _domShown;
    private double? _swipeStartX;

    /// <summary>The note's images (already filtered to <c>IsImage</c> attachments).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Attachment> Images { get; set; } = [];

    /// <summary>The image shown, or null when the viewer is closed.</summary>
    [Parameter] public int? Index { get; set; }

    /// <summary>Called when paging to another image.</summary>
    [Parameter] public EventCallback<int> IndexChanged { get; set; }

    /// <summary>Called when the viewer is closed (the close button, Esc, or the backdrop).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private bool Open => Index is { } i && i >= 0 && i < Images.Count;

    private Attachment? Image => Open ? Images[Index!.Value] : null;

    private bool Many => Images.Count > 1;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _domShown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/dialogs.js");
        _self ??= DotNetObjectReference.Create(this);
        if (Open)
        {
            await _module.InvokeVoidAsync("showModal", _dialog, _self);
        }
        else
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }

        _domShown = Open;
    }

    /// <summary>Called from dialogs.js when Esc is pressed or the backdrop clicked.</summary>
    [JSInvokable]
    public Task Cancel() => CloseAsync();

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task GoAsync(int step)
    {
        if (Index is not { } index)
        {
            return Task.CompletedTask;
        }

        var next = ((index + step) % Images.Count + Images.Count) % Images.Count;
        return IndexChanged.InvokeAsync(next);
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowRight" when Many => GoAsync(1),
        "ArrowLeft" when Many => GoAsync(-1),
        _ => Task.CompletedTask,
    };

    private Task OnPointerUpAsync(PointerEventArgs e)
    {
        if (_swipeStartX is not { } start || !Many)
        {
            return Task.CompletedTask;
        }

        var distance = e.ClientX - start;
        _swipeStartX = null;
        return Math.Abs(distance) > 50 ? GoAsync(distance < 0 ? 1 : -1) : Task.CompletedTask;
    }

    private async Task SaveCopyAsync()
    {
        if (Image is not { } image)
        {
            return;
        }

        try
        {
            if (await Attachments.OpenAsync(image.Id) is not { } media)
            {
                Toasts.Error("Could not save a copy of this file.");
                return;
            }

            await using var content = media.Content;
            await Saver.SaveAsync(image.FileName, content);
        }
        catch (Exception)
        {
            Toasts.Error("Could not save a copy of this file.");
        }
    }

    private async Task ShareAsync()
    {
        if (Image is not { } image)
        {
            return;
        }

        try
        {
            var folder = Path.Combine(Directories.CacheDirectory, "open");
            if (await Attachments.CopyDecryptedAsync(image.Id, folder) is not { } path)
            {
                Toasts.Error("Could not share this file.");
                return;
            }

            await Share.ShareFileAsync(path, image.ContentType);
        }
        catch (Exception)
        {
            Toasts.Error("Could not share this file.");
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
