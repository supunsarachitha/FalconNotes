@* Port of AttachmentThumbnail in components/AttachmentGallery.tsx: a small square thumbnail of a stored attachment,
   used in the composer's list while editing a note. The media handler serves the file directly from its URL, so
   there is no decrypt-and-wait step here, unlike the web app's. A sticker is shown whole, not cropped (docs/07,
   Stickers). *@
@using FalconNotes.Core.Domain
<img src="@MediaUrl.For(Attachment)" alt="@Attachment.FileName" class="@(Contain ? "size-full object-contain p-1" : "size-full object-cover")" />

@code {
    /// <summary>The stored attachment.</summary>
    [Parameter, EditorRequired] public Attachment Attachment { get; set; } = null!;

    /// <summary>Shows the whole picture inside the square instead of filling it.</summary>
    [Parameter] public bool Contain { get; set; }
}
