@* Port of components/Markdown.tsx: renders a note's Markdown as HTML (Core/Markdown/MarkdownRenderer.cs; GitHub
   flavour, raw HTML dropped, #tags linked, safe links). With OnToggleTask set, task-list checkboxes tick in place
   and report which item's list marker changed (its offset in Content, per MarkdownEdit.ToggleTask); without it, every
   checkbox is disabled (an archived note). *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Markdown
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject MarkdownRenderer Renderer

<div @ref="_container">
    @((MarkupString)Html)
</div>

@code {
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Markdown>? _self;
    private bool _bound;

    /// <summary>The note being shown; its ID and revision key the render cache.</summary>
    [Parameter, EditorRequired] public Note Note { get; set; } = null!;

    /// <summary>The text to render; the note's body (its content after any title) when it has one.</summary>
    [Parameter, EditorRequired] public string Content { get; set; } = "";

    /// <summary>Called with a task item's offset when its checkbox is ticked or unticked; left unset for a note
    /// that cannot be changed, which disables every checkbox.</summary>
    [Parameter] public EventCallback<int> OnToggleTask { get; set; }

    private string Html => Renderer.Render(Note.Id, Note.Revision, Content, OnToggleTask.HasDelegate);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!OnToggleTask.HasDelegate || _bound)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/markdown.js");
        _self ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("bindTaskToggle", _container, _self);
        _bound = true;
    }

    /// <summary>Called from markdown.js when a task checkbox in this note is ticked or unticked.</summary>
    /// <param name="offset">Where its item's list marker starts in <see cref="Content"/>.</param>
    [JSInvokable]
    public Task ToggleTask(int offset) => OnToggleTask.InvokeAsync(offset);

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unbindTaskToggle", _container);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
