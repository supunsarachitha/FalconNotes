@* The note card's actions menu (DropdownMenu in components/NoteCard.tsx), without Radix: an icon button that opens a
   menu aligned to its end, 4 px below, with arrow keys, Enter, Esc and outside clicks (docs/06, Components). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="relative">
    <button @ref="_trigger" type="button" aria-label="@Label" title="@Label" aria-haspopup="menu"
            aria-expanded="@(_open ? "true" : "false")" @onclick="ToggleAsync"
            class="@Classes.Join(TriggerClass, Classes.FocusRing)">
        @Trigger
    </button>
    @if (_open)
    {
        <div @ref="_menu" role="menu" aria-label="@Label" style="position: fixed; visibility: hidden" class="@MenuClass">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </div>
    }
</div>

@code {
    private ElementReference _trigger;
    private ElementReference _menu;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DropdownMenu>? _self;
    private bool _open;
    private bool _wire;

    /// <summary>The trigger's accessible name and tooltip, e.g. "Note actions".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The trigger's icon.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>The trigger's classes, in full (shape and colours, not just extras): a round icon button by default,
    /// as in the note card's menu.</summary>
    [Parameter]
    public string TriggerClass { get; set; } =
        "inline-flex size-10 shrink-0 items-center justify-center rounded-full text-stone-600 transition-colors hover:bg-stone-100 disabled:opacity-40 dark:text-stone-300 dark:hover:bg-stone-800";

    /// <summary>The open panel's classes, in full: a column of menu items by default, as in the note card's menu. A
    /// grid of swatches, say, overrides it (LabelColorPicker).</summary>
    [Parameter]
    public string MenuClass { get; set; } =
        "z-50 min-w-48 rounded-xl border border-stone-200 bg-white p-1 text-stone-800 shadow-lg dark:border-stone-700 dark:bg-stone-900 dark:text-stone-100";

    /// <summary>The <see cref="MenuItem"/>s and separators.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Closes the menu (after an item is chosen, or from the page).</summary>
    /// <returns>A task that completes when it is closed.</returns>
    [JSInvokable]
    public async Task Close()
    {
        if (!_open)
        {
            return;
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("closeMenu", _menu);
        }

        _open = false;
        StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_wire)
        {
            _wire = false;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/dialogs.js");
            _self ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("openMenu", _trigger, _menu, _self);
        }
    }

    private async Task ToggleAsync()
    {
        if (_open)
        {
            await Close();
            return;
        }

        _open = true;
        _wire = true;
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
