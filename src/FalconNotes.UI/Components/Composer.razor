@* Port of components/Composer.tsx: writes a new note or edits an existing one. Files are added as soon as they are
   chosen, so posting is instant; the note only references their IDs. With note titles on, a title field is shown,
   saved as the note's first line (lib/titles.ts), and may start with today's date. Editing starts with the caret at
   the end; with tag suggestions on, existing tags are offered while a #tag is typed.

   Adapted per docs/02 and docs/07: the paperclip opens the native file picker (IFilePicker) instead of a hidden
   HTML input, so there is no local blob preview while a file is "uploading" — it streams straight into the
   encrypted store, which the Phase 0 spike found fast even for large files. Paste and drag-and-drop are a
   follow-up. *@
@using FalconNotes.Core.Attachments
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Notes
@using FalconNotes.Core.Platform
@using FalconNotes.Core.Text
@using FalconNotes.UI.State
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NoteService Notes
@inject DailyNotes DailyNotes
@inject AttachmentService Attachments
@inject IFilePicker Picker
@inject AppState State
@inject Toasts Toasts
@inject TimeProvider Time
@inject IServiceProvider ServiceProvider

<div class="rounded-2xl border border-stone-200 bg-white p-3 shadow-sm dark:border-stone-800 dark:bg-stone-900">
    @if (Daily is not null)
    {
        <p class="mb-1 border-b border-stone-100 px-1 pb-2 pt-1 text-base font-semibold dark:border-stone-800">@Daily.Title</p>
    }
    @if (WithTitle)
    {
        <input type="text" value="@_title" @oninput="OnTitleInput" @onkeydown="OnTitleKeyDownAsync"
               aria-label="@(Editing ? "Edit title" : "Title")" placeholder="Title" maxlength="300"
               class="mb-1 block w-full border-b border-stone-100 bg-transparent px-1 pb-2 pt-1 text-base font-semibold text-stone-900 outline-none placeholder:font-normal placeholder:text-stone-400 dark:border-stone-800 dark:text-stone-100" />
    }

    <label for="@TextareaId" class="sr-only">@(Editing ? "Edit note" : "New note")</label>
    <div class="relative">
        <textarea id="@TextareaId" @ref="_textarea" value="@_text" @oninput="OnTextInputAsync" @onselect="OnSelectAsync"
                  @onblur="OnBlur" @onkeydown="OnTextKeyDownAsync" rows="@(Editing ? 3 : 2)"
                  placeholder="@(Editing ? null : Placeholder)"
                  aria-autocomplete="@(State.Preferences.TagSuggestions ? "list" : null)"
                  aria-controls="@_suggestions?.AriaControls" aria-activedescendant="@_suggestions?.AriaActiveDescendant"
                  class="block w-full resize-none bg-transparent px-1 py-1 text-base leading-relaxed text-stone-900 outline-none placeholder:text-stone-400 dark:text-stone-100"></textarea>
        <TagSuggestions @ref="_suggestions" Target="_textarea" Enabled="State.Preferences.TagSuggestions" OnTextChanged="OnSuggestionChosenAsync" />
    </div>

    <FormatToolbar @ref="_formatToolbar" Target="_textarea" />

    @if (_files.Count > 0)
    {
        <ul class="mt-2 flex flex-wrap gap-2" aria-label="Attached files">
            @foreach (var file in _files)
            {
                <li class="relative flex h-20 w-20 items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-stone-50 dark:border-stone-700 dark:bg-stone-800"
                    title="@($"{file.Name} ({Bytes.Format(file.Size)})")">
                    @if (file.Attachment is { IsImage: true } shown)
                    {
                        <AttachmentThumbnail Attachment="shown" />
                    }
                    else
                    {
                        <div class="flex flex-col items-center gap-1 px-1 text-center">
                            <Icon Name="IconName.FileText" Class="size-5 text-maple-600 dark:text-maple-400" />
                            <span class="line-clamp-2 break-all text-[10px] leading-tight text-stone-600 dark:text-stone-300">@file.Name</span>
                        </div>
                    }

                    @if (file.Attachment is null && file.Error is null)
                    {
                        <div class="absolute inset-x-1 bottom-1 h-1.5 overflow-hidden rounded-full bg-black/20">
                            <div class="h-full bg-maple-500 transition-[width]" style="width: @(Math.Round(file.Progress * 100))%"></div>
                        </div>
                    }
                    @if (file.Error is { } error)
                    {
                        <div class="absolute inset-0 flex items-center justify-center bg-red-900/80 p-1" title="@error">
                            <Icon Name="IconName.AlertCircle" Class="size-5 text-white" />
                        </div>
                    }

                    <button type="button" @onclick="() => RemoveFileAsync(file)" aria-label="@($"Remove {file.Name}")"
                            class="absolute right-1 top-1 flex size-6 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80">
                        <Icon Name="IconName.X" Class="size-3.5" />
                    </button>
                </li>
            }
        </ul>
    }

    <div class="mt-2 flex items-center gap-2 border-t border-stone-100 pt-2 dark:border-stone-800">
        <IconButton Label="Attach files" OnClick="PickFilesAsync"><Icon Name="IconName.Paperclip" Class="size-5" /></IconButton>
        @if (Content.Length > MaxLength * 0.9)
        {
            <span class="@Classes.Join("text-xs", Content.Length > MaxLength ? "text-red-700" : "text-stone-500")">
                @Content.Length.ToString("N0") / @MaxLength.ToString("N0")
            </span>
        }
        <span class="hidden text-xs text-stone-400 sm:inline">Ctrl/⌘ + Enter to @(Editing ? "save" : "post")</span>
        <div class="ml-auto flex gap-2">
            @if (Editing)
            {
                <Button Variant="ButtonVariant.Ghost" OnClick="CancelAsync">Cancel</Button>
            }
            <Button OnClick="SaveAsync" Disabled="!CanSave" Busy="_saving">@(Editing ? "Save" : "Post")</Button>
        </div>
    </div>
</div>

@code {
    /// <summary>Starts a day's daily note: the title is the date and cannot be changed here.</summary>
    /// <param name="Date">The day.</param>
    /// <param name="Title">The date, formatted as the title.</param>
    public sealed record DailyInfo(DateOnly Date, string Title);

    private const int MaxLength = NoteService.MaxContentLength;
    private const int MaxTextareaPixels = 480;

    private readonly List<ComposerFile> _files = [];
    private ElementReference _textarea;
    private TagSuggestions? _suggestions;
    private FormatToolbar? _formatToolbar;
    private IJSObjectReference? _module;
    private string _title = "";
    private string _suggestedTitle = "";
    private string _text = "";
    private bool _saving;

    /// <summary>The note to edit; omit to write a new note.</summary>
    [Parameter] public Note? Note { get; set; }

    /// <summary>Called after a successful save, or when an edit is cancelled.</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    /// <summary>Focuses the text, caret at the end, as soon as the composer appears.</summary>
    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Offers the title field when the user has note titles on.</summary>
    [Parameter] public bool AllowTitle { get; set; } = true;

    /// <summary>The kind a new note becomes.</summary>
    [Parameter] public NoteKind Kind { get; set; } = NoteKind.Note;

    /// <summary>Shown in the text box while it is empty and not being edited.</summary>
    [Parameter] public string Placeholder { get; set; } = "What's on your mind? Use #tags and **Markdown**.";

    /// <summary>Starts a day's daily note.</summary>
    [Parameter] public DailyInfo? Daily { get; set; }

    private bool Editing => Note is not null;

    private bool WithTitle => AllowTitle && State.Preferences.NoteTitles && Daily is null;

    private string TextareaId => Editing ? $"edit-{Note!.Id}" : "composer";

    private string Content => Daily is not null
        ? Titles.Join(Daily.Title, _text)
        : WithTitle ? Titles.Join(_title, _text) : _text;

    // A title counts as something written only when typed, not when it is just today's date.
    private bool TypedTitle => WithTitle && _title.Trim().Length > 0 && _title.Trim() != _suggestedTitle.Trim();

    private bool Uploading => _files.Any(f => f.Attachment is null && f.Error is null);

    private List<Guid> AttachmentIds => _files.Where(f => f.Attachment is not null).Select(f => f.Attachment!.Id).ToList();

    private bool CanSave => !_saving && !Uploading && Content.Length <= MaxLength
        && (_text.Trim().Length > 0 || AttachmentIds.Count > 0 || TypedTitle);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var (initialTitle, initialBody) = Note is not null && WithTitle ? Titles.Split(Note.Content) : ("", Note?.Content ?? "");
        _suggestedTitle = SuggestTitle();
        _title = initialTitle.Length > 0 ? initialTitle : _suggestedTitle;
        _text = initialBody;
        _files.AddRange((Note?.Attachments ?? []).Select(FromAttachment));
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var module = await ModuleAsync();
        await module.InvokeVoidAsync("bindAutoGrow", _textarea, MaxTextareaPixels);
        if (AutoFocus)
        {
            await module.InvokeVoidAsync("focusAtEnd", _textarea);
        }
    }

    private string SuggestTitle() =>
        Note is null && WithTitle && State.Preferences.DateInTitles ? DateFormats.Format(Today(), State.Preferences.DateFormat) : "";

    private DateOnly Today() => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(Time.GetUtcNow(), Time.LocalTimeZone).DateTime);

    private static ComposerFile FromAttachment(Attachment attachment) => new()
    {
        Key = $"existing-{attachment.Id}", Name = attachment.FileName, Size = attachment.SizeBytes,
        IsImage = attachment.IsImage, Attachment = attachment, Progress = 1, Existing = true,
    };

    private void OnTitleInput(ChangeEventArgs e) => _title = e.Value?.ToString() ?? "";

    private async Task OnTitleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey))
        {
            await SaveAsync();
        }
        else if (e.Key == "Enter")
        {
            var module = await ModuleAsync();
            await module.InvokeVoidAsync("focus", _textarea);
        }
        else if (e.Key == "Escape" && Editing)
        {
            await CancelAsync();
        }
    }

    private async Task OnTextInputAsync(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        if (_suggestions is not null)
        {
            await _suggestions.UpdateAsync();
        }
    }

    private Task OnSelectAsync() => _suggestions?.UpdateAsync() ?? Task.CompletedTask;

    private void OnBlur() => _suggestions?.Close();

    private async Task OnTextKeyDownAsync(KeyboardEventArgs e)
    {
        if (_suggestions is not null && await _suggestions.OnKeyDownAsync(e.Key, e.MetaKey, e.CtrlKey, e.ShiftKey))
        {
            return;
        }

        var format = FormatToolbar.ShortcutFormat(e.Key, e.MetaKey, e.CtrlKey, e.AltKey, e.ShiftKey);
        if (format is { } f)
        {
            if (_formatToolbar is not null)
            {
                await _formatToolbar.ApplyAsync(f);
            }
        }
        else if (e.Key == "Enter" && (e.MetaKey || e.CtrlKey))
        {
            await SaveAsync();
        }
        else if (e.Key == "Escape" && Editing)
        {
            await CancelAsync();
        }
    }

    private Task OnSuggestionChosenAsync(string text)
    {
        _text = text;
        return Task.CompletedTask;
    }

    private async Task PickFilesAsync()
    {
        var picked = await Picker.PickFilesAsync();
        foreach (var file in picked)
        {
            StartAdding(file);
        }
    }

    private void StartAdding(PickedFile file)
    {
        var type = file.ContentType ?? "";
        var entry = new ComposerFile
        {
            Key = $"new-{Guid.NewGuid():N}",
            Name = string.IsNullOrEmpty(file.FileName) ? "pasted-image.png" : file.FileName,
            IsImage = type.StartsWith("image/", StringComparison.OrdinalIgnoreCase) && type != "image/svg+xml",
            Existing = false,
        };
        _files.Add(entry);
        StateHasChanged();
        _ = UploadAsync(entry, file);
    }

    private async Task UploadAsync(ComposerFile entry, PickedFile file)
    {
        try
        {
            var stream = await file.OpenReadAsync();
            var name = UploadPolicy.SanitizeFileName(file.FileName);
            var toAdd = new FileToAdd(stream, name, UploadPolicy.ResolveContentType(file.ContentType, name));

            // "Shrink photos" needs the platform's IImageCodec (docs/02). A platform that has none yet registers no
            // PhotoShrinker, and its files are added as they are.
            if (State.Preferences.ShrinkPhotos && ServiceProvider.GetService<PhotoShrinker>() is { } shrinker)
            {
                toAdd = await shrinker.ShrinkAsync(toAdd, entry.Cancel.Token);
                entry.Name = toAdd.FileName;
            }

            entry.Size = toAdd.Content.CanSeek ? toAdd.Content.Length - toAdd.Content.Position : 0;
            await InvokeAsync(StateHasChanged);
            var progress = new Progress<long>(bytes =>
            {
                entry.Progress = entry.Size > 0 ? Math.Min(1.0, (double)bytes / entry.Size) : 0;
                _ = InvokeAsync(StateHasChanged);
            });
            entry.Attachment = await Attachments.AddAsync(toAdd.Content, toAdd.FileName, toAdd.ContentType, progress, entry.Cancel.Token);
            entry.Progress = 1;
        }
        catch (OperationCanceledException)
        {
            // removed while it was being added
        }
        catch (Exception e)
        {
            entry.Error = e is UserFacingException ? e.Message : "Could not add this file.";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RemoveFileAsync(ComposerFile file)
    {
        await file.Cancel.CancelAsync();
        _files.Remove(file);
        StateHasChanged();
        if (file is { Attachment: not null, Existing: false })
        {
            try
            {
                await Attachments.RemoveUnattachedAsync(file.Attachment.Id);
            }
            catch (Exception)
            {
                // best effort: clean-up will remove it later if this fails
            }
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            return;
        }

        _saving = true;
        try
        {
            if (Editing)
            {
                await Notes.UpdateAsync(Note!.Id, Content, AttachmentIds);
            }
            else if (Daily is { } daily)
            {
                await DailyNotes.SaveAsync(daily.Date, daily.Title, _text, AttachmentIds);
            }
            else
            {
                await Notes.CreateAsync(Content, Kind, AttachmentIds);
            }

            if (!Editing)
            {
                _suggestedTitle = SuggestTitle();
                _title = _suggestedTitle;
                _text = "";
                _files.Clear();
                var module = await ModuleAsync();
                await module.InvokeVoidAsync("growNow", _textarea, MaxTextareaPixels);
            }

            await OnDone.InvokeAsync();
        }
        catch (UserFacingException e)
        {
            Toasts.Error(e.Message);
        }
        catch (Exception)
        {
            Toasts.Error("Could not save the note.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        foreach (var file in _files.Where(f => !f.Existing).ToList())
        {
            await RemoveFileAsync(file);
        }

        await OnDone.InvokeAsync();
    }

    private async Task<IJSObjectReference> ModuleAsync() => _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/editor.js");

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        foreach (var file in _files)
        {
            file.Cancel.Dispose();
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    /// <summary>A file shown in the composer: already on the note, or added while writing it.</summary>
    private sealed class ComposerFile
    {
        public required string Key { get; init; }

        public required string Name { get; set; }

        public long Size { get; set; }

        public required bool IsImage { get; init; }

        public Attachment? Attachment { get; set; }

        public double Progress { get; set; }

        public string? Error { get; set; }

        /// <summary>Already attached to the note being edited, so not deleted when it is removed before saving.</summary>
        public required bool Existing { get; init; }

        public CancellationTokenSource Cancel { get; } = new();
    }
}
