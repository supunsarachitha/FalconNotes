@* Port of components/ConfirmDialog.tsx with <dialog> + showModal() instead of Radix (docs/06, Components). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" aria-labelledby="@_titleId"
        class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl bg-white p-6 text-stone-900 shadow-xl backdrop:bg-black/50 backdrop:backdrop-blur-sm dark:bg-stone-900 dark:text-stone-100">
    @if (Open)
    {
        <h2 id="@_titleId" class="text-lg font-semibold">@Title</h2>
        <div class="mt-2 text-sm text-stone-600 dark:text-stone-300">@Description</div>
        @ChildContent
        <div class="mt-6 flex justify-end gap-2">
            <Button Variant="ButtonVariant.Ghost" OnClick="CancelAsync">Cancel</Button>
            <Button Variant="ButtonVariant.Danger" OnClick="OnConfirm" Busy="Busy" Disabled="!ConfirmEnabled">@ConfirmLabel</Button>
        </div>
    }
</dialog>

@code {
    private readonly string _titleId = $"dialog-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ConfirmDialog>? _self;
    private bool _shown;

    /// <summary>Whether the dialog is open.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Called with false when the dialog is cancelled (Cancel, Esc or the backdrop).</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The heading.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>What will happen.</summary>
    [Parameter] public RenderFragment? Description { get; set; }

    /// <summary>More content under the description, such as a "Type ERASE" field.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The danger button's label.</summary>
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = "";

    /// <summary>Whether the danger button can be pressed yet.</summary>
    [Parameter] public bool ConfirmEnabled { get; set; } = true;

    /// <summary>Called when the danger button is pressed.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Shows a spinner on the danger button while its action runs.</summary>
    [Parameter] public bool Busy { get; set; }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/dialogs.js");
        _self ??= DotNetObjectReference.Create(this);
        if (Open)
        {
            await _module.InvokeVoidAsync("showModal", _dialog, _self);
        }
        else
        {
            await _module.InvokeVoidAsync("close", _dialog);
        }

        _shown = Open;
    }

    /// <summary>Called from the page when Esc is pressed or the backdrop clicked.</summary>
    /// <returns>A task that completes when the parent knows.</returns>
    [JSInvokable]
    public Task Cancel() => CancelAsync();

    private Task CancelAsync() => Busy ? Task.CompletedTask : OpenChanged.InvokeAsync(false);

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
