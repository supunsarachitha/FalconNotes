@* Port of Switch in components/ui.tsx: an accessible on/off switch (role="switch"), 48 × 28 px. *@
<button type="button" role="switch" aria-checked="@(Checked ? "true" : "false")" aria-label="@Label"
        aria-describedby="@DescribedBy" disabled="@Disabled" @onclick="Toggle" class="@ButtonClass">
    <span class="@KnobClass"></span>
</button>

@code {
    /// <summary>Whether it is on.</summary>
    [Parameter] public bool Checked { get; set; }

    /// <summary>Called with the new state.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>The accessible name.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Disables the switch.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>The ID of the element that explains the switch.</summary>
    [Parameter] public string? DescribedBy { get; set; }

    private string ButtonClass => Classes.Join(
        "relative inline-flex h-7 w-12 shrink-0 items-center rounded-full transition-colors disabled:opacity-50",
        Checked ? "bg-maple-600" : "bg-stone-300 dark:bg-stone-700",
        Classes.FocusRing);

    private string KnobClass => Classes.Join(
        "inline-block size-5 rounded-full bg-white shadow transition-transform",
        Checked ? "translate-x-6" : "translate-x-1");

    private Task Toggle() => CheckedChanged.InvokeAsync(!Checked);
}
