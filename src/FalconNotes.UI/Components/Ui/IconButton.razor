@* Port of IconButton in components/ui.tsx: a round, icon-only button; the label is its accessible name and tooltip. *@
<button type="@Type" aria-label="@Label" title="@Label" disabled="@Disabled" class="@CssClass" @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    /// <summary>The accessible name and tooltip. Required.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Extra classes.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The button's type.</summary>
    [Parameter] public string Type { get; set; } = "button";

    /// <summary>Disables the button.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Called on click.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => Classes.Join(
        "inline-flex size-10 shrink-0 items-center justify-center rounded-full text-stone-600 transition-colors",
        "hover:bg-stone-100 disabled:opacity-40 dark:text-stone-300 dark:hover:bg-stone-800",
        Classes.FocusRing,
        Class);
}
