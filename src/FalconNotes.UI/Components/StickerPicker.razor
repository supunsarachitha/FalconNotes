@* New here (docs/07, Stickers; the web app has none): the stickers of the packs on this device, to put on the note
   being written. A tab for each pack when there are several; each sticker chosen is added, and the picker stays open so
   several can be. With no pack yet, it says where to add one. *@
@using FalconNotes.Core.Stickers
@inject StickerPackService Packs

<div id="@Id" role="group" aria-label="Stickers" class="mt-2 border-t border-stone-100 pt-2 dark:border-stone-800">
    @if (_packs is null)
    {
        <p class="px-1 py-2 text-sm text-stone-500 dark:text-stone-400">Loading…</p>
    }
    else if (_packs.Count == 0)
    {
        <p class="px-1 py-2 text-sm text-stone-600 dark:text-stone-300">
            No sticker packs yet. Add one in <a href="/settings/features" class="font-medium text-maple-700 underline-offset-2 hover:underline dark:text-maple-400">Settings → Features</a>.
        </p>
    }
    else
    {
        @if (_packs.Count > 1)
        {
            <div class="mb-2 flex gap-1 overflow-x-auto pb-1" aria-label="Sticker packs">
                @foreach (var pack in _packs)
                {
                    var shown = pack == Shown;
                    <button type="button" aria-pressed="@(shown ? "true" : "false")" @onclick="() => _shownId = pack.Id"
                            class="@Classes.Join(
                                       "shrink-0 rounded-full px-3 py-1 text-sm font-medium transition-colors",
                                       shown ? "bg-maple-100 text-maple-800 dark:bg-maple-600/20 dark:text-maple-300" : "text-stone-600 hover:bg-stone-100 dark:text-stone-300 dark:hover:bg-stone-800",
                                       Classes.FocusRing)">
                        @pack.Name
                    </button>
                }
            </div>
        }
        <ul class="grid max-h-64 grid-cols-4 gap-1 overflow-y-auto sm:grid-cols-6" aria-label="@Shown!.Name">
            @foreach (var sticker in Shown!.Stickers)
            {
                <li>
                    <button type="button" aria-label="@($"Add sticker: {sticker.Name}")" title="@sticker.Name"
                            @onclick="() => OnChosen.InvokeAsync(sticker)"
                            class="@Classes.Join("flex aspect-square w-full items-center justify-center rounded-xl p-1 transition-colors hover:bg-stone-100 dark:hover:bg-stone-800", Classes.FocusRing)">
                        <img src="@MediaUrl.For(Shown, sticker)" alt="" loading="lazy" decoding="async" class="size-full object-contain" />
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    private IReadOnlyList<StickerPack>? _packs;
    private string? _shownId;

    /// <summary>The picker's ID, which the button that opens it names in <c>aria-controls</c>.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Called with each sticker chosen.</summary>
    [Parameter] public EventCallback<Sticker> OnChosen { get; set; }

    private StickerPack? Shown => _packs?.FirstOrDefault(p => p.Id == _shownId) ?? _packs?.FirstOrDefault();

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() => _packs = await Packs.ListAsync();
}
