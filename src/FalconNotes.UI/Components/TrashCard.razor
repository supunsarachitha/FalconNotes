@* Port of TrashCard in pages/TrashPage.tsx: a note in the trash, what it was, when it was deleted, and Restore or
   Delete forever. Its files are not loaded (docs/07: the intro drops the storage sentence, kept otherwise). *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Notes
@using FalconNotes.Core.Text
@using HabitsText = FalconNotes.Core.Text.Habits
@using FalconNotes.UI.State
@inject NoteService Notes
@inject Toasts Toasts
@inject TimeProvider Time

<article class="note-card rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-stone-800 dark:bg-stone-900">
    <header class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-stone-500 dark:text-stone-400">
        <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs font-medium text-stone-600 dark:bg-stone-800 dark:text-stone-300">
            @KindName
        </span>
        <time datetime="@DeletedAtUtc.ToString("o")" title="@RelativeTime.Absolute(DeletedAtUtc, Time.LocalTimeZone, true)">
            Deleted @RelativeTime.Format(DeletedAtUtc, Time.GetUtcNow(), Time.LocalTimeZone)
        </time>
        <span>· @DaysLeftText</span>
    </header>

    @if (Habit is { } habit)
    {
        <p class="font-medium">
            @(habit.Name.Length > 0 ? habit.Name : "Untitled habit")
            <span class="font-normal text-stone-500 dark:text-stone-400">· @habit.Days.Count @(habit.Days.Count == 1 ? "day" : "days") done</span>
        </p>
    }
    else if (Note.Content.Trim().Length > 0)
    {
        <div class="relative max-h-48 overflow-hidden">
            <Markdown Note="Note" Content="@Note.Content" />
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-white dark:from-stone-900"></div>
        </div>
    }
    @if (Note.Attachments.Count > 0)
    {
        <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">With @Note.Attachments.Count @(Note.Attachments.Count == 1 ? "file" : "files")</p>
    }

    <div class="mt-3 flex flex-wrap gap-2">
        <Button Variant="ButtonVariant.Secondary" Class="h-9" Busy="_restoring" OnClick="RestoreAsync">
            <Icon Name="IconName.RotateCcw" Class="size-4" /> Restore
        </Button>
        <Button Variant="ButtonVariant.Ghost" Class="h-9 text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950" OnClick="() => _confirming = true">
            <Icon Name="IconName.Trash2" Class="size-4" /> Delete forever…
        </Button>
    </div>

    <ConfirmDialog Open="_confirming" OpenChanged="open => _confirming = open" Title="Delete forever?" ConfirmLabel="Delete forever" Busy="_deleting" OnConfirm="DeleteForeverAsync">
        <Description>
            @(Note.Attachments.Count > 0
                ? $"It and its {Note.Attachments.Count} {(Note.Attachments.Count == 1 ? "file" : "files")} will be deleted permanently. This cannot be undone."
                : "It will be deleted permanently. This cannot be undone.")
        </Description>
    </ConfirmDialog>
</article>

@code {
    private bool _confirming;
    private bool _restoring;
    private bool _deleting;

    /// <summary>The note, todo list, quick note or habit in the trash.</summary>
    [Parameter, EditorRequired] public Note Note { get; set; } = null!;

    private DateTime DeletedAtUtc => Note.TrashedAtUtc ?? Note.UpdatedAtUtc;

    private int DaysLeft => NoteService.DaysLeftInTrash(DeletedAtUtc, Time.GetUtcNow().UtcDateTime);

    private string DaysLeftText => DaysLeft == 0 ? "deleted for good today" : $"deleted for good in {DaysLeft} {(DaysLeft == 1 ? "day" : "days")}";

    private string KindName => Note.Kind switch
    {
        NoteKind.Todo => "Todo list",
        NoteKind.Quick => "Quick note",
        NoteKind.Habit => "Habit",
        _ => "Note",
    };

    private Habit? Habit => Note.Kind == NoteKind.Habit ? HabitsText.Parse(Note.Content) : null;

    private async Task RestoreAsync()
    {
        _restoring = true;
        try
        {
            var restored = await Notes.PatchAsync(Note.Id, new NotePatch(IsTrashed: false));
            Toasts.Info(restored is { IsArchived: true } ? "Restored to the archive." : "Restored.");
        }
        catch (Exception)
        {
            Toasts.Error("Could not restore it. Please try again.");
        }
        finally
        {
            _restoring = false;
        }
    }

    private async Task DeleteForeverAsync()
    {
        _deleting = true;
        try
        {
            await Notes.DeleteAsync(Note.Id);
            _confirming = false;
            Toasts.Info("Deleted for good.");
        }
        catch (Exception)
        {
            Toasts.Error("Could not delete it. Please try again.");
        }
        finally
        {
            _deleting = false;
        }
    }
}
