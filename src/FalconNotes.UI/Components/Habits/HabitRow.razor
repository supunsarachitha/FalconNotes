@namespace FalconNotes.UI.Components
@* Port of HabitRow in components/HabitRow.tsx: tap a day to mark it done or not done; rename, archive or delete the
   habit from its menu. Every tick shows at once and is saved in the background as the habit's Markdown
   (Core/Text/Habits.cs, NoteEditor). *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Notes
@using FalconNotes.Core.Text
@using HabitsText = FalconNotes.Core.Text.Habits
@using FalconNotes.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NoteService Notes
@inject AppState State
@inject Toasts Toasts

<li class="@(HabitLayout.Row) py-2.5">
    @if (_renaming)
    {
        <input @ref="_renameInput" aria-label="Habit name" value="@_draft" maxlength="300"
               @oninput="@(e => _draft = e.Value?.ToString() ?? "")" @onblur="FinishRename" @onkeydown="OnKey"
               class="w-full min-w-0 rounded-lg border border-stone-300 bg-white px-2 py-1 text-[15px] font-medium outline-none focus:border-maple-500 dark:border-stone-700 dark:bg-stone-950" />
    }
    else
    {
        <span class="min-w-0 break-words font-medium">@Name</span>
    }

    <DropdownMenu Label="Habit actions"
                  TriggerClass="@(Classes.Join("inline-flex size-10 shrink-0 items-center justify-center rounded-full text-stone-600 transition-colors hover:bg-stone-100 disabled:opacity-40 dark:text-stone-300 dark:hover:bg-stone-800", "sm:order-3"))">
        <Trigger><Icon Name="IconName.MoreHorizontal" Class="size-5" /></Trigger>
        <ChildContent>
            <MenuItem IconName="IconName.Pencil" OnSelect="StartRename">Rename</MenuItem>
            <MenuItem IconName="IconName.Archive" OnSelect="ArchiveAsync">Archive</MenuItem>
            <MenuSeparator />
            <MenuItem IconName="IconName.Trash2" Danger="true" OnSelect="_removal.StartAsync">@_removal.MenuLabel</MenuItem>
        </ChildContent>
    </DropdownMenu>

    <div class="@(HabitLayout.DayGrid)">
        @foreach (var day in Days)
        {
            var isDone = _habit.Days.Contains(day);
            <button type="button" aria-pressed="@(isDone ? "true" : "false")" aria-label="@DayLabel(day)" @onclick="() => Toggle(day)"
                    class="@DayClass(isDone, day == Today)">
                <Icon Name="IconName.Check" Class="size-5" StrokeWidth="3" />
            </button>
        }
    </div>

    <ConfirmDialog Open="_removal.Confirming" OpenChanged="@(open => { if (!open) { _removal.CancelConfirm(); } })"
                    Title="@_removal.ConfirmTitle" ConfirmLabel="Delete" Busy="_removal.Removing" OnConfirm="_removal.ConfirmAsync">
        <Description>
            "@Name"@(_habit.Days.Count > 0 ? $" and its history ({HabitLayout.DayCount(_habit.Days.Count)} done)" : "") will be deleted permanently.@(Note.IsArchived ? "" : " To keep its history out of sight instead, archive it.")
        </Description>
    </ConfirmDialog>
</li>

@code {
    private IJSObjectReference? _module;
    private NoteEditor<Habit> _editor = null!;
    private NoteRemoval _removal = null!;
    private bool _renaming;
    private string _draft = "";
    private bool _focusRename;
    private ElementReference _renameInput;

    /// <summary>The habit's note.</summary>
    [Parameter, EditorRequired] public Note Note { get; set; } = null!;

    /// <summary>The days shown, oldest first.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Days { get; set; } = [];

    /// <summary>Today's day key (<c>yyyy-MM-dd</c>), for the "today" badge and its aria-label.</summary>
    [Parameter, EditorRequired] public string Today { get; set; } = "";

    private Habit _habit => _editor.Value;

    private string Name => HabitLayout.Name(_habit);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _editor = new NoteEditor<Habit>(Notes, Note, HabitsText.Parse, HabitsText.Serialize,
            _ => Toasts.Error("A change to this habit could not be saved. Please try again."));
        _removal = new NoteRemoval(Note, "habit", "Delete this habit?", "", Notes, State, Toasts, StateHasChanged);
    }

    /// <inheritdoc />
    protected override void OnParametersSet() => _editor.Reload(Note);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRename)
        {
            return;
        }

        _focusRename = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/editor.js");
        await _module.InvokeVoidAsync("focusAtEnd", _renameInput);
    }

    private void Toggle(string day) => _editor.Commit(HabitsText.ToggleDay(_habit, day));

    private void StartRename()
    {
        _draft = _habit.Name;
        _renaming = true;
        _focusRename = true;
    }

    private void FinishRename()
    {
        _renaming = false;
        var clean = _draft.Trim();
        if (clean.Length > 0 && clean != _habit.Name)
        {
            _editor.Commit(_habit with { Name = clean });
        }
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            FinishRename();
        }
        else if (e.Key == "Escape")
        {
            _renaming = false;
        }
    }

    private async Task ArchiveAsync()
    {
        try
        {
            await Notes.PatchAsync(Note.Id, new NotePatch(IsArchived: true));
            Toasts.Info("Archived. It keeps its history under Archived habits.");
        }
        catch (Exception)
        {
            Toasts.Error("That didn't work. Please try again.");
        }
    }

    private string DayLabel(string day) =>
        $"{Name}, {(day == Today ? "today, " : "")}{DateFormats.Format(DateFormats.ParseKey(day)!.Value, "dddd, MMMM d")}";

    private static string DayClass(bool isDone, bool isToday) => Classes.Join(
        "flex size-10 items-center justify-center rounded-full border-2 transition-colors sm:size-9",
        Classes.FocusRing,
        isDone
            ? "border-maple-600 bg-maple-600 text-white hover:bg-maple-700 dark:border-maple-500 dark:bg-maple-500 dark:text-stone-950"
            : Classes.Join(
                "text-transparent hover:border-maple-400 dark:hover:border-maple-500",
                isToday ? "border-maple-500 dark:border-maple-400" : "border-stone-300 dark:border-stone-600"));

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
