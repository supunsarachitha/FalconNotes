@namespace FalconNotes.UI.Components
@* Port of components/HabitCalendar.tsx: a month at a glance under the Habits list: for one habit, the days it was
   done; for all of them, the days all or some were done. Days before a habit started and after today do not count.
   It only shows; days are ticked in the list. *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Text
@using HabitsText = FalconNotes.Core.Text.Habits
@inject TimeProvider Time

<section aria-labelledby="@_headingId" class="mt-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-stone-800 dark:bg-stone-900">
    <div class="flex flex-wrap items-center gap-2">
        <h2 id="@_headingId" class="mr-auto text-base font-semibold">Calendar</h2>
        <select aria-label="Habits in the calendar" value="@(Single?.Id.ToString() ?? "all")" @onchange="@(e => _selected = e.Value?.ToString() ?? "all")"
                class="h-9 max-w-48 min-w-0 rounded-full border border-stone-300 bg-white px-3 text-sm dark:border-stone-700 dark:bg-stone-950">
            <option value="all">All habits</option>
            @foreach (var habit in _habits)
            {
                <option value="@habit.Id">@habit.Name</option>
            }
        </select>
    </div>

    <div class="mx-auto mt-3 max-w-sm">
        <div class="mb-1 flex items-center gap-1">
            <IconButton Label="Previous month" OnClick="() => _monthsBack++" Class="-ml-2"><Icon Name="IconName.ChevronLeft" Class="size-5" /></IconButton>
            <p class="flex-1 text-center text-sm font-medium" aria-live="polite">@DateFormats.Format(DateFormats.ParseKey(Month.Start)!.Value, "MMMM yyyy")</p>
            <IconButton Label="Next month" Disabled="@(_monthsBack == 0)" OnClick="() => _monthsBack--" Class="-mr-2"><Icon Name="IconName.ChevronRight" Class="size-5" /></IconButton>
        </div>
        <div class="grid grid-cols-7 text-center text-xs font-medium text-stone-400" aria-hidden="true">
            @foreach (var name in Weekdays)
            {
                <span class="py-1">@name</span>
            }
        </div>
        <ol class="grid grid-cols-7 gap-1">
            @for (var i = 0; i < Blanks; i++)
            {
                <li aria-hidden="true"></li>
            }
            @foreach (var day in HabitsText.DaysOf(Month))
            {
                var (done, possible) = Score(day);
                var level = possible == 0 ? "none" : done == 0 ? "missed" : done == possible ? "all" : "some";
                var date = DateFormats.ParseKey(day)!.Value;
                <li class="flex justify-center">
                    <span class="@DayClass(level, day == Today)">
                        <span aria-hidden="true">@date.Day</span>
                        <span class="sr-only">@DayDescription(date, day, done, possible)</span>
                    </span>
                </li>
            }
        </ol>
        @if (Single is null)
        {
            <p class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs text-stone-500 dark:text-stone-400" aria-hidden="true">
                <span class="flex items-center gap-1.5"><span class="size-3 rounded-full bg-maple-600"></span> All done</span>
                <span class="flex items-center gap-1.5"><span class="size-3 rounded-full bg-maple-100 dark:bg-maple-700/40"></span> Some done</span>
            </p>
        }
        <p class="mt-3 text-center text-sm text-stone-600 dark:text-stone-400">@Summary()</p>
    </div>
</section>

@code {
    private readonly string _headingId = $"habit-calendar-{Guid.NewGuid():N}";
    private string _selected = "all";
    private int _monthsBack;
    private IReadOnlyList<HabitSummary> _habits = [];

    private sealed record HabitSummary(Guid Id, string Name, string Start, IReadOnlyList<string> Days);

    private static readonly string[] WeekdayNames = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];

    /// <summary>The active habits' notes.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Note> Notes { get; set; } = [];

    /// <summary>Today's day key (<c>yyyy-MM-dd</c>).</summary>
    [Parameter, EditorRequired] public string Today { get; set; } = "";

    /// <summary>The week's first day.</summary>
    [Parameter] public DayOfWeek WeekStart { get; set; } = DayOfWeek.Sunday;

    /// <inheritdoc />
    protected override void OnParametersSet() =>
        _habits = Notes.Select(note =>
        {
            var habit = HabitsText.Parse(note.Content);
            return new HabitSummary(note.Id, HabitLayout.Name(habit), HabitsText.Start(habit, note.CreatedAtUtc, Time.LocalTimeZone), habit.Days);
        }).ToList();

    private HabitSummary? Single => _habits.FirstOrDefault(h => h.Id.ToString() == _selected);

    private IReadOnlyList<TrackedHabit> Tracked =>
        (Single is { } single ? [single] : _habits).Select(h => new TrackedHabit(h.Start, h.Days)).ToList();

    private Period Month => HabitsText.MonthOf(Today, -_monthsBack);

    private int Blanks => ((int)HabitsText.Weekday(Month.Start) - (int)WeekStart + 7) % 7;

    private IEnumerable<string> Weekdays => Enumerable.Range(0, 7).Select(i => WeekdayNames[(i + (int)WeekStart) % 7]);

    private (int Done, int Possible) Score(string day)
    {
        var score = HabitsText.ScorePeriod(Tracked, new Period(day, day), Today);
        return (score.Done, score.Possible);
    }

    private string DayDescription(DateOnly date, string day, int done, int possible)
    {
        var prefix = DateFormats.Format(date, "dddd, MMMM d") + (day == Today ? " (today)" : "");
        return $"{prefix}: {Describe(day, done, possible)}";
    }

    private string Describe(string day, int done, int possible)
    {
        if (possible == 0)
        {
            return string.CompareOrdinal(day, Today) > 0 ? "still to come" : Single is not null ? "before this habit started" : "no habits yet";
        }

        if (Single is not null)
        {
            return done != 0 ? "done" : "not done";
        }

        return $"{done} of {possible} {(possible == 1 ? "habit" : "habits")} done";
    }

    private string Summary()
    {
        var total = HabitsText.ScorePeriod(Tracked, Month, Today);
        if (total.Possible == 0)
        {
            return "Nothing to count in this month yet.";
        }

        return Single is not null
            ? $"{total.Done} of {HabitLayout.DayCount(total.Possible)} done"
            : $"{Math.Round((double)total.Done / total.Possible * 100, MidpointRounding.AwayFromZero)}% of habit days done";
    }

    private static string DayClass(string level, bool isToday) => Classes.Join(
        "flex aspect-square w-full max-w-10 items-center justify-center rounded-full text-sm tabular-nums",
        level == "all" ? "bg-maple-600 font-semibold text-white" : null,
        level == "some" ? "bg-maple-100 font-medium text-maple-700 dark:bg-maple-700/40 dark:text-stone-100" : null,
        level == "missed" ? "text-stone-700 dark:text-stone-300" : null,
        level == "none" ? "text-stone-300 dark:text-stone-600" : null,
        isToday ? "ring-2 ring-maple-500 ring-offset-1 dark:ring-offset-stone-900" : null);
}
