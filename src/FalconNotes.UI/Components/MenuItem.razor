@* Port of MenuItem in components/NoteCard.tsx: an icon and a label; danger items are red. *@
<button type="button" role="menuitem" tabindex="-1" @onclick="SelectAsync" class="@CssClass">
    <Icon Name="IconName" Class="size-4" />
    @ChildContent
</button>

@code {
    /// <summary>The menu it is in.</summary>
    [CascadingParameter] public DropdownMenu? Menu { get; set; }

    /// <summary>The icon.</summary>
    [Parameter, EditorRequired] public IconName IconName { get; set; }

    /// <summary>The label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Called when chosen; the menu closes first.</summary>
    [Parameter] public EventCallback OnSelect { get; set; }

    /// <summary>A destructive action, shown in red.</summary>
    [Parameter] public bool Danger { get; set; }

    private string CssClass => Classes.Join(
        "flex w-full cursor-pointer select-none items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm outline-none",
        Danger
            ? "text-red-700 hover:bg-red-50 focus:bg-red-50 dark:text-red-400 dark:hover:bg-red-950 dark:focus:bg-red-950"
            : "hover:bg-stone-100 focus:bg-stone-100 dark:hover:bg-stone-800 dark:focus:bg-stone-800");

    private async Task SelectAsync()
    {
        if (Menu is not null)
        {
            await Menu.Close();
        }

        await OnSelect.InvokeAsync();
    }
}
