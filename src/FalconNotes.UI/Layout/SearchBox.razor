@* Port of SearchBox in components/AppShell.tsx. *@
@inject NavigationManager Navigation

<form role="search" @onsubmit="SubmitAsync" @onsubmit:preventDefault class="relative">
    <Icon Name="IconName.Search" Class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-stone-400" />
    <input type="search" value="@_value" @oninput="e => _value = e.Value?.ToString() ?? string.Empty" placeholder="Search notes" aria-label="Search notes"
           class="h-10 w-full rounded-full border border-stone-200 bg-stone-50 pl-9 pr-3 text-sm outline-none focus:border-maple-500 focus:bg-white dark:border-stone-700 dark:bg-stone-800 dark:focus:bg-stone-900" />
</form>

@code {
    private string _value = "";

    /// <summary>Called after a search starts (closes the drawer).</summary>
    [Parameter] public EventCallback OnNavigate { get; set; }

    /// <inheritdoc />
    protected override void OnInitialized() => _value = PageAddress.Of(Navigation).Query.GetValueOrDefault("q") ?? "";

    private async Task SubmitAsync()
    {
        var q = _value.Trim();
        Navigation.NavigateTo(q.Length > 0 ? $"/?q={Uri.EscapeDataString(q)}" : "/");
        await OnNavigate.InvokeAsync();
    }
}
