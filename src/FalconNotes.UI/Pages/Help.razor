@page "/help"
@* Port of pages/HelpPage.tsx (docs/07, Help; docs/08): a contents list, then every section of the guide. Unlike
   ported screen text, the guide speaks of the app by its own name throughout, so there is no renaming pass here.
   In-app links navigate inside the app through Blazor's normal link interception; the page foot shows the version. *@
@using FalconNotes.Core.Markdown
@using FalconNotes.UI.Help

<h1 class="mb-1 text-xl font-semibold">Help</h1>
<p class="mb-4 text-sm text-stone-600 dark:text-stone-300">How to get the most out of Falcon Notes.</p>

<nav aria-label="Contents" class="mb-6 rounded-2xl border border-stone-200 bg-white p-4 shadow-sm dark:border-stone-800 dark:bg-stone-900">
    <h2 class="mb-2 text-sm font-semibold">Contents</h2>
    <ol class="grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
        @foreach (var section in Guide.Sections)
        {
            <li>
                <a href="@($"#help-{section.Id}")" class="text-maple-700 underline decoration-maple-700/30 underline-offset-2 hover:decoration-maple-700 dark:text-maple-400">
                    @section.Title
                </a>
            </li>
        }
    </ol>
</nav>

<div class="flex flex-col gap-4">
    @foreach (var section in Guide.Sections)
    {
        <section id="@($"help-{section.Id}")" tabindex="-1" aria-labelledby="@($"help-{section.Id}-title")"
                 class="scroll-mt-20 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm outline-none dark:border-stone-800 dark:bg-stone-900">
            <h2 id="@($"help-{section.Id}-title")" class="mb-2 text-base font-semibold">@section.Title</h2>
            @((MarkupString)MarkdownRenderer.Render(section.Body, interactive: false))
        </section>
    }
</div>
<VersionNote />
