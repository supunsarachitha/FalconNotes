@page "/quick"
@* Port of QuickNotesPage: a scratchpad kept out of the timeline. A quick note worth keeping moves to Home. *@
@using FalconNotes.Core.Domain
@using FalconNotes.UI.State
@inject AppState State

<h1 class="mb-1 text-xl font-semibold">Quick notes</h1>
@if (!State.Preferences.QuickNotes)
{
    <div class="mt-4">
        <FeatureOff Title="Quick notes are turned off">Your quick notes are kept and come back when you turn them on again.</FeatureOff>
    </div>
}
else
{
    <p class="mb-4 text-sm text-stone-600 dark:text-stone-300">
        Jot things down without filling your timeline. Move a note to Home from its menu when it is worth keeping.
    </p>
    <Composer Kind="NoteKind.Quick" AllowTitle="State.Preferences.QuickNoteTitles" Placeholder="Jot something down…" />
    <div class="mt-6 flex flex-col gap-6">
        <NoteList State="NoteState.Pinned" Kinds="@(new[] { NoteKind.Quick })" RenderNote="QuickCard" ShowEndMarker="false">
            <Header>
                <h2 class="px-1 text-xs font-semibold uppercase tracking-wide text-stone-500 dark:text-stone-400">Pinned</h2>
            </Header>
        </NoteList>
        <NoteList State="NoteState.Feed" Kinds="@(new[] { NoteKind.Quick })" RenderNote="QuickCard">
            <Empty><EmptyState Title="No quick notes">Anything you jot down here stays out of your timeline.</EmptyState></Empty>
        </NoteList>
    </div>
}

@code {
    private static RenderFragment QuickCard(Note note) => builder =>
    {
        builder.OpenComponent<NoteCard>(0);
        builder.AddComponentParameter(1, nameof(NoteCard.Note), note);
        builder.AddComponentParameter(2, nameof(NoteCard.ShowKind), false);
        builder.CloseComponent();
    };
}
