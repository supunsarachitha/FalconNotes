@page "/archive"
@* Port of ArchivePage in pages/HomePage.tsx: archived notes (and todo lists and quick notes), with restore and
   delete available from each one's menu. *@
@using FalconNotes.Core.Domain
@using FalconNotes.UI.State
@inject AppState State

@if (!State.Preferences.Archive)
{
    <h1 class="mb-4 text-xl font-semibold">Archive</h1>
    <FeatureOff Title="The Archive is turned off">Your archived notes are kept.</FeatureOff>
}
else
{
    <h1 class="mb-1 text-xl font-semibold">Archive</h1>
    <p class="mb-4 text-sm text-stone-600 dark:text-stone-300">
        Archived notes are hidden from your feed and searches. Restore them any time.
    </p>
    <NoteList State="NoteState.Archived" Kinds="State.EnabledKinds">
        <Empty><EmptyState Title="The archive is empty" /></Empty>
    </NoteList>
}
