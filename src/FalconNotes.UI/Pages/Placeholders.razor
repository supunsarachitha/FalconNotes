@page "/help"
@page "/settings"
@page "/settings/{Section}"
@* The pages later phases port (docs/10): each says which phase brings it. *@
@inject NavigationManager Navigation

<h1 class="mb-4 text-xl font-semibold">@Title</h1>
<EmptyState Title="Not ported yet">This page comes in @Phase of the implementation plan.</EmptyState>

@code {
    /// <summary>The settings section, if any.</summary>
    [Parameter] public string? Section { get; set; }

    private string Path => Layout.PageAddress.Of(Navigation).Path;

    private string Title => Path switch
    {
        "/help" => "Help",
        _ => "Settings",
    };

    private string Phase => "Phase 6";
}
