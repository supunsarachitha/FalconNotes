@* Port of FeaturesSection in components/PreferenceSections.tsx (Maple Notes 1.15.0), adapted (docs/07, Settings →
   Features): without Link previews; "Shrink photos before uploading" becomes "Shrink photos before adding" (docs/08,
   Pictures, video and files); with Help out of the menu, the guide is opened from the foot of Settings, since there
   is no address to type. *@
@using FalconNotes.UI.State
@inject AppState State

<Section Title="Pages">
    <Description>Each one adds a page to the side menu. Turning one off hides it; nothing is deleted.</Description>
    <ChildContent>
        <div class="divide-y divide-stone-100 dark:divide-stone-800">
            <PreferenceSwitch Label="Todo lists" Description="A Todo tab for checklists you create and tick off."
                               Checked="State.Preferences.TodoLists" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { TodoLists = on }))" />
            <PreferenceSwitch Label="Quick notes" Description="A Quick notes tab: a scratchpad for short notes that stay out of your timeline."
                               Checked="State.Preferences.QuickNotes" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { QuickNotes = on }))" />
            <PreferenceSwitch Label="Habit tracker" Description="A Habits tab: tick off your daily habits and see your progress in a chart."
                               Checked="State.Preferences.HabitTracker" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { HabitTracker = on }))" />
            <PreferenceSwitch Label="Tags page" Description="A Tags page listing every tag with how many notes use it. Tags in your notes work either way."
                               Checked="State.Preferences.Tags" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { Tags = on }))" />
            <PreferenceSwitch Label="Archive"
                               Description="An Archive page for notes you put away, and the Archive action on notes and lists. Turning it off hides them; archived notes are kept."
                               Checked="State.Preferences.Archive" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { Archive = on }))" />
            <PreferenceSwitch Label="Help in the menu"
                               Description="Help in the side menu. Turning it off hides the item; the guide is then opened from the foot of Settings."
                               Checked="State.Preferences.HelpMenu" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { HelpMenu = on }))" />
        </div>
    </ChildContent>
</Section>

<Section Title="Home and menu">
    <div class="divide-y divide-stone-100 dark:divide-stone-800">
        <PreferenceSwitch Label="Daily notes"
                           Description="Show today's note at the top of Home, titled with the date. It is saved the first time you write in it, so days you skip leave no empty notes."
                           Checked="State.Preferences.DailyNotes" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { DailyNotes = on }))" />
        @if (State.Preferences.DailyNotes)
        {
            <DailyTemplateSetting TemplateId="@State.Preferences.DailyNoteTemplate"
                                  OnClear="@(() => State.UpdatePreferencesAsync(p => p with { DailyNoteTemplate = "" }))" />
        }
        <PreferenceSwitch Label="Calendar" Description="A month calendar in the side menu. Days with notes are marked; choose one to see its notes."
                           Checked="State.Preferences.Calendar" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { Calendar = on }))" />
        <PreferenceSwitch Label="Labels"
                           Description="Coloured labels you put on notes and todo lists from their ⋯ menu, listed in the side menu. Manage them under Settings → Labels."
                           Checked="State.Preferences.Labels" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { Labels = on }))" />
    </div>
</Section>

<Section Title="Notes and files">
    <div class="divide-y divide-stone-100 dark:divide-stone-800">
        <PreferenceSwitch Label="Trash"
                           Description="Deleted notes go to the trash, where you can restore them for 30 days; it is in Settings → Backup & data. Off, deleting is immediate and permanent."
                           Checked="State.Preferences.Trash" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { Trash = on }))" />
        <div class="py-3 first:pt-0 last:pb-0">
            <PreferenceSwitch Label="Shrink photos before adding"
                               Description="Large photos are resized and saved as JPEG, often a tenth of the size or less. Their location and camera details are left out too. Photos already added stay as they are."
                               Checked="State.Preferences.ShrinkPhotos" CheckedChanged="@(on => State.UpdatePreferencesAsync(p => p with { ShrinkPhotos = on }))" />
            @if (State.Preferences.ShrinkPhotos)
            {
                <PhotoSizeChoice Value="State.Preferences.PhotoSize"
                                 ValueChanged="@(size => State.UpdatePreferencesAsync(p => p with { PhotoSize = size }))" />
            }
        </div>
    </div>
</Section>
