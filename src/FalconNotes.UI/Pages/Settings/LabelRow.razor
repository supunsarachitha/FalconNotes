@* Port of LabelRow in components/LabelSettings.tsx: a label's colour, name, note count and actions (hide or show
   its notes, rename, delete). Changes save at once through LabelService; the list reloads itself from
   ChangeFeed.LabelsChanged (LabelSettings), so this component only triggers the change. *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Labels
@using FalconNotes.UI.State
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject LabelService Labels
@inject Toasts Toasts

<li class="flex min-h-12 items-center gap-2 py-1.5">
    <LabelColorPicker Color="LabelCount.Label.Color" Label="@($"Colour of {LabelCount.Label.Name}")" ColorChanged="ChangeColorAsync" />
    @if (_renaming)
    {
        <input @ref="_renameInput" aria-label="@($"New name for {LabelCount.Label.Name}")" value="@_draft" maxlength="@LabelRules.MaxNameLength"
               @oninput="@(e => _draft = e.Value?.ToString() ?? "")" @onblur="RenameAsync" @onkeydown="OnKeyAsync"
               class="h-9 min-w-0 flex-1 rounded-lg border border-stone-300 bg-white px-2 text-sm outline-none focus:border-maple-500 dark:border-stone-700 dark:bg-stone-950" />
    }
    else
    {
        <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium">@LabelCount.Label.Name</span>
            @if (LabelCount.Label.HideNotes)
            {
                <span class="block text-xs text-stone-500 dark:text-stone-400">Notes hidden</span>
            }
        </span>
    }
    <a href="@($"/?label={Uri.EscapeDataString(LabelCount.Label.Id.ToString())}")"
       class="shrink-0 rounded-full px-2 py-1 text-xs tabular-nums text-stone-500 hover:bg-stone-100 hover:text-stone-800 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-stone-100">
        @(LabelCount.NoteCount == 1 ? "1 note" : $"{LabelCount.NoteCount} notes")
    </a>
    <IconButton Label="@(LabelCount.Label.HideNotes ? $"Show notes labelled {LabelCount.Label.Name} on Home and in Quick notes" : $"Hide notes labelled {LabelCount.Label.Name} from Home and Quick notes")"
                aria-pressed="@(LabelCount.Label.HideNotes ? "true" : "false")"
                Class="@Classes.Join("size-9", LabelCount.Label.HideNotes ? "text-maple-700 dark:text-maple-400" : null)" OnClick="ToggleHideNotesAsync">
        <Icon Name="@(LabelCount.Label.HideNotes ? IconName.EyeOff : IconName.Eye)" Class="size-4" />
    </IconButton>
    <IconButton Label="@($"Rename {LabelCount.Label.Name}")" Class="size-9" OnClick="StartRename"><Icon Name="IconName.Pencil" Class="size-4" /></IconButton>
    <IconButton Label="@($"Delete {LabelCount.Label.Name}")" Class="size-9" OnClick="@(() => _confirming = true)"><Icon Name="IconName.Trash2" Class="size-4" /></IconButton>
    <ConfirmDialog Open="_confirming" OpenChanged="open => _confirming = open" Title="@($"Delete the label “{LabelCount.Label.Name}”?")"
                    ConfirmLabel="Delete label" Busy="_deleting" OnConfirm="DeleteAsync">
        <Description>
            @(LabelCount.NoteCount > 0
                ? $"It comes off its {(LabelCount.NoteCount == 1 ? "note" : $"{LabelCount.NoteCount} notes")}. The notes themselves stay as they are."
                : "No note has it. Nothing else changes.")
        </Description>
    </ConfirmDialog>
</li>

@code {
    private bool _renaming;
    private string _draft = "";
    private bool _confirming;
    private bool _deleting;
    private bool _focusRename;
    private ElementReference _renameInput;
    private IJSObjectReference? _module;

    /// <summary>The label and how many notes carry it.</summary>
    [Parameter, EditorRequired] public LabelCount LabelCount { get; set; } = null!;

    /// <summary>Every other label, to check a new name is not already taken.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Label> AllLabels { get; set; } = [];

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRename)
        {
            return;
        }

        _focusRename = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FalconNotes.UI/js/editor.js");
        await _module.InvokeVoidAsync("focusAtEnd", _renameInput);
    }

    private void StartRename()
    {
        _draft = LabelCount.Label.Name;
        _renaming = true;
        _focusRename = true;
    }

    private async Task RenameAsync()
    {
        if (!_renaming)
        {
            return;
        }

        _renaming = false;
        var name = _draft.Trim();
        if (name.Length == 0 || name == LabelCount.Label.Name)
        {
            return;
        }

        if (LabelRules.HasLabelNamed(AllLabels.Select(l => (l.Id, l.Name)), name, LabelCount.Label.Id))
        {
            Toasts.Error($"You already have a label called “{name}”.");
            return;
        }

        try
        {
            await Labels.UpdateAsync(LabelCount.Label.Id, name: name);
        }
        catch (UserFacingException e)
        {
            Toasts.Error(e.Message);
        }
    }

    private async Task OnKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RenameAsync();
        }
        else if (e.Key == "Escape")
        {
            _renaming = false;
        }
    }

    private async Task ChangeColorAsync(LabelColor color)
    {
        try
        {
            await Labels.UpdateAsync(LabelCount.Label.Id, color: color);
        }
        catch (Exception)
        {
            Toasts.Error("Could not change the colour.");
        }
    }

    private async Task ToggleHideNotesAsync()
    {
        try
        {
            await Labels.UpdateAsync(LabelCount.Label.Id, hideNotes: !LabelCount.Label.HideNotes);
        }
        catch (Exception)
        {
            Toasts.Error("Could not change where the label's notes show.");
        }
    }

    private async Task DeleteAsync()
    {
        _deleting = true;
        try
        {
            await Labels.DeleteAsync(LabelCount.Label.Id);
            _confirming = false;
            Toasts.Info($"Label “{LabelCount.Label.Name}” deleted.");
        }
        catch (Exception)
        {
            Toasts.Error("Could not delete the label.");
        }
        finally
        {
            _deleting = false;
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
