@* Port of components/LabelSettings.tsx: turning labels on or off, and the account's labels to create, rename,
   recolour or delete. docs/07: the note about end-to-end encryption is gone (there is no such mode here); "Exports
   do not include labels yet" stays. Not yet placed in a Settings page shell (Phase 6); reached directly for now. *@
@using FalconNotes.Core.Domain
@using FalconNotes.Core.Events
@using FalconNotes.Core.Labels
@using FalconNotes.UI.State
@implements IDisposable
@inject LabelService Labels
@inject AppState State
@inject ChangeFeed Feed
@inject Toasts Toasts

<Section Title="Labels">
    <div class="flex items-start gap-4 py-3 first:pt-0 last:pb-0">
        <div class="min-w-0 flex-1">
            <p class="text-sm font-medium">Use labels</p>
            <p id="@_switchDescId" class="mt-0.5 text-sm text-stone-600 dark:text-stone-300">
                Put coloured labels on notes and todo lists from their ⋯ menu, and find a label's notes in the side menu.
                Turning labels off hides them; nothing is deleted.
            </p>
        </div>
        <Switch Label="Use labels" DescribedBy="@_switchDescId" Checked="State.Preferences.Labels" CheckedChanged="ToggleAsync" />
    </div>
</Section>

<Section Title="Your labels">
    <Description>
        Unlike #tags, which come from what you write, labels are put on by hand, so they never change a note's text.
    </Description>
    <ChildContent>
    <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <div class="flex items-center gap-2">
            <LabelColorPicker Color="NewColor" Label="Colour of the new label" ColorChanged="color => _newColor = color" />
            <input value="@_newName" @oninput="OnNewNameInput" placeholder="New label, e.g. Work" aria-label="New label name"
                   maxlength="@LabelRules.MaxNameLength" aria-invalid="@(_error is not null ? "true" : null)"
                   class="h-10 min-w-0 flex-1 rounded-xl border border-stone-300 bg-white px-3 text-sm outline-none focus:border-maple-500 dark:border-stone-700 dark:bg-stone-950" />
            <Button Type="submit" Busy="_creating" Disabled="@(_newName.Trim().Length == 0)" Class="h-10">
                <Icon Name="IconName.Plus" Class="size-4" /> Add
            </Button>
        </div>
        @if (_error is not null)
        {
            <p role="alert" class="mt-1.5 text-sm text-red-700 dark:text-red-400">@_error</p>
        }
    </form>
    @if (!_loaded)
    {
        <p class="mt-4 text-sm text-stone-500">Loading labels…</p>
    }
    else if (_labels.Count == 0)
    {
        <p class="mt-4 text-sm text-stone-500 dark:text-stone-400">No labels yet.</p>
    }
    else
    {
        <ul aria-label="Your labels" class="mt-3 divide-y divide-stone-100 dark:divide-stone-800">
            @foreach (var count in _labels)
            {
                <LabelRow @key="count.Label.Id" LabelCount="count" AllLabels="@(_labels.Select(c => c.Label).ToList())" />
            }
        </ul>
    }
    <p class="mt-3 text-xs text-stone-500 dark:text-stone-400">
        Up to @LabelRules.MaxLabels labels, @LabelRules.MaxNameLength characters each, and @LabelRules.MaxPerNote on a note.
        Exports do not include labels yet.
    </p>
    </ChildContent>
</Section>

@code {
    private readonly string _switchDescId = $"labels-switch-desc-{Guid.NewGuid():N}";
    private List<LabelCount> _labels = [];
    private bool _loaded;
    private string _newName = "";
    private LabelColor? _newColor;
    private string? _error;
    private bool _creating;

    private LabelColor NewColor => _newColor ?? LabelRules.NextColor(_labels.Count);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Feed.LabelsChanged += Reload;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _labels = (await Labels.ListAsync(State.EnabledKinds)).ToList();
        _loaded = true;
    }

    private void Reload() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task ToggleAsync(bool on) => await State.UpdatePreferencesAsync(p => p with { Labels = on });

    private void OnNewNameInput(ChangeEventArgs e)
    {
        _newName = e.Value?.ToString() ?? "";
        _error = null;
    }

    private async Task CreateAsync()
    {
        var clean = _newName.Trim();
        if (clean.Length == 0)
        {
            return;
        }

        if (LabelRules.HasLabelNamed(_labels.Select(c => (c.Label.Id, c.Label.Name)), clean))
        {
            _error = $"You already have a label called “{clean}”.";
            return;
        }

        _creating = true;
        try
        {
            await Labels.CreateAsync(clean, NewColor);
            _newName = "";
            _newColor = null;
            _error = null;
        }
        catch (UserFacingException e)
        {
            Toasts.Error(e.Message);
        }
        finally
        {
            _creating = false;
        }
    }

    /// <inheritdoc />
    public void Dispose() => Feed.LabelsChanged -= Reload;
}
