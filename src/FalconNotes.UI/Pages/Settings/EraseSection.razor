@* New (docs/07, Settings → Profile → Erase all data; docs/04, Starting over): deletes the database, attachments,
   database copies, cache, localStorage and the device key, then shows Welcome. *@
@using FalconNotes.Core.Startup
@using FalconNotes.UI.State
@inject EraseAllData Erase
@inject AppBootstrapper Bootstrapper
@inject AppState State
@inject AppearanceService Appearance
@inject AppLockState AppLock
@inject NavigationManager Navigation
@inject IJSRuntime JS

<Section Title="Erase all data">
    <Description>Delete everything Falcon Notes keeps on this device and start again: notes, files, labels, settings and the app lock.</Description>
    <ChildContent>
        <Button Variant="ButtonVariant.Danger" OnClick="Open">Erase all data…</Button>
    </ChildContent>
</Section>

<VerifyPinDialog Open="_verifying" OpenChanged="v => _verifying = v" OnVerified="OnVerifiedAsync" />

<ConfirmDialog Open="_open" OpenChanged="OnOpenChanged" Title="Erase all data?" ConfirmLabel="Erase everything"
               ConfirmEnabled="@(_typed == "ERASE")" Busy="_busy" OnConfirm="RunAsync">
    <Description>
        <p>Every note, todo list, quick note, habit, label, file and setting on this device is deleted, and its encryption key is destroyed. This cannot be undone.</p>
        <p class="mt-2">Export your notes first if you might want them back.</p>
    </Description>
    <ChildContent>
        <label class="mt-4 flex flex-col gap-1.5 text-sm">
            <span class="font-medium">Type ERASE to confirm</span>
            <input value="@_typed" @oninput="OnTypedInput"
                   class="h-10 rounded-xl border border-stone-300 bg-white px-3 dark:border-stone-700 dark:bg-stone-950" />
        </label>
    </ChildContent>
</ConfirmDialog>

@code {
    private bool _open;
    private bool _verifying;
    private bool _busy;
    private string _typed = "";

    private void Open()
    {
        if (AppLock.Settings.Enabled)
        {
            _verifying = true;
        }
        else
        {
            _open = true;
        }
    }

    private void OnVerifiedAsync()
    {
        _verifying = false;
        _open = true;
    }

    private void OnOpenChanged(bool open)
    {
        _open = open;
        if (!open)
        {
            _typed = "";
        }
    }

    private void OnTypedInput(ChangeEventArgs e) => _typed = e.Value?.ToString() ?? "";

    private async Task RunAsync()
    {
        _busy = true;
        await Erase.RunAsync();
        await Bootstrapper.RestartAsync();
        State.Clear();
        var module = await Appearance.ModuleAsync(JS);
        await module.InvokeVoidAsync("forget");
        Navigation.NavigateTo("/welcome", replace: true);
    }
}
