<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Android first (docs/10, Phase 0). Mac Catalyst and Windows are added when their spikes run. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>FalconNotes.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Falcon Notes</ApplicationTitle>
    <!-- Never change after the first release: a new ID is a new app, and users would lose their data (docs/12). -->
    <ApplicationId>lk.stechbuzz.falconnotes</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And $(TargetFramework.Contains('-android'))">
    <TrimMode>partial</TrimMode>
    <!-- The .aab goes to Google Play; the .apk is for direct installs and for testing the release build (docs/12). -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
  </PropertyGroup>

  <!--
    Release signing. The keystore details stay out of source control: they are in signing.local.props (git-ignored;
    see signing.local.props.example) or come from the command line, e.g. -p:AndroidSigningStorePass=env:KEYSTORE_PASS.
    Without them (as in CI) a Release build is signed with the debug key, which no store accepts.
  -->
  <Import Project="signing.local.props" Condition="Exists('signing.local.props')" />
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(AndroidSigningKeyStore)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
  </PropertyGroup>

  <ItemGroup>
    <!-- The falcon mark (docs/06, App icon and splash; fixtures/falcon-mark.png), replaced 2026-10-07. -->
    <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#fdf3f3" ForegroundScale="0.65" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#f5f5f4" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FalconNotes.Core\FalconNotes.Core.csproj" />
    <ProjectReference Include="..\FalconNotes.UI\FalconNotes.UI.csproj" />
  </ItemGroup>

</Project>
