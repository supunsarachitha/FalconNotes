<!--
  Copy this file to signing.local.props (git-ignored) and fill in the upload key's details.
  Release builds are then signed with it.
  A password can also come from an environment variable: <AndroidSigningStorePass>env:KEYSTORE_PASS</AndroidSigningStorePass>
-->
<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidSigningKeyStore>/path/to/your.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>your-alias</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:KEYSTORE_PASS</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:KEYSTORE_PASS</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
