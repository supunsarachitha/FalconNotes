<Project>
  <!--
    Central package management: every NuGet version is pinned here, projects reference packages without versions.
    Only the dependencies listed in docs/02-architecture.md#dependencies are allowed. Before adding or upgrading one,
    check its licence (and its dependencies' licences) and update THIRD-PARTY-NOTICES.md.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="App">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
  </ItemGroup>

  <ItemGroup Label="Core and UI">
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <!-- SQLite with encryption (MIT); the app uses its AEGIS-256 cipher. Embedded code: see THIRD-PARTY-NOTICES.md. -->
    <PackageVersion Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <!-- Markdown rendering (BSD-2-Clause; no dependencies on .NET 10). -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.11.3" />
  </ItemGroup>
</Project>
